# ---------------------------------------------------------------------------
# myfinancial — local configuration
# Copy to `.env` (gitignored — NEVER commit real keys to this public repo;
# GitHub scans and attackers scrape leaked tokens within minutes).
# For CI/automation, use GitHub Actions Secrets instead:  gh secret set NAME
# ---------------------------------------------------------------------------

# Session HMAC + vault/settings encryption master — set a long random value
MYFIN_SECRET=change-me-to-a-long-random-string

# ---- Market data (optional; ⚙ Connections panel works too) ----------------
# MYFIN_PROVIDER=upstox            # upstox | fyers | synthetic
# UPSTOX_ACCESS_TOKEN=             # from your Upstox app's daily login flow
# FYERS_APP_ID=XXXXXXXX-100
# FYERS_ACCESS_TOKEN=

# ---- FYERS auto-refresh (for scripts/refresh_fyers_token.mjs / CI) ---------
# FYERS_SECRET_ID=                 # app secret from myapi.fyers.in
# FYERS_REFRESH_TOKEN=             # issued at login, valid ~15 days
# FYERS_PIN=                       # your 4-digit API pin

# ---- AI writing (optional) --------------------------------------------------
# AIMLAPI_KEY=
# AIMLAPI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=               # assistant verbalisation (Claude)
